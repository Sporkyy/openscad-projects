# scadformat writes a timestamped backup next to every file it formats
*.scadbak

# Scratch STL exports at the repository root
/*.stl

# Interrupted generated-artifact builds
*.tmp.stl
*.tmp.png
__pycache__/

# The developer venv, built by `make install`
.venv/

# Slicer projects stay local
*.3mf

# Support Fins output and its --resume checkpoints are print prep too
*-fins*.stl
*.fins-cache/

.DS_Store

# Pinned Markdown tooling (package.json)
node_modules/
