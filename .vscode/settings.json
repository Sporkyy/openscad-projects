{
  // The venv `make install` builds, built from Homebrew's python@3.14. An
  // explicitly selected interpreter wins over this, so a workspace that already
  // has one picked needs it re-picked once after the venv exists.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python-envs.defaultEnvManager": "ms-python.python:venv",

  // The tests are unittest, discovered from the repository root with
  // `.venv/bin/python -m unittest discover -s tests`. Nothing here is pytest, so
  // the runner should launch unittest against the same directory.
  //
  // The analysis bar is deliberately not set here. It lives in pyproject.toml's
  // [tool.pyright], which the editor and any pyright CLI both read; a
  // python.analysis.* setting would reach only the editor.
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
