// SPDX-License-Identifier: MIT
{
  // Prettier owns layout: prose wrapped at 100 columns, tables aligned, list
  // markers consistent. This preset turns off the markdownlint rules that would
  // argue with it, so markdownlint checks only what a formatter can't.
  "extends": "markdownlint/style/prettier",
  // Every block here is fenced. Saying so makes an indented block a finding
  // rather than a silent new baseline for the style check.
  "MD046": { "style": "fenced" }
}
